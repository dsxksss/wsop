# 复制为 .env 后按需修改
# SQLite 数据库文件（相对 server crate 根目录；目录不存在会自动创建）
DATABASE_URL=sqlite://data/wsop.db

# JWT 签名密钥（生产务必改成足够长的随机串）
JWT_SECRET=change-me-to-a-long-random-secret

# 客户文件空间根目录
STORAGE_ROOT=storage

# 监听地址
BIND_ADDR=127.0.0.1:8787

# 启动时若没有任何用户，自动创建的初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@example.com

# 开发期演示数据：设为 1/true 且库中无客户时，自动填充一批假数据
# （客户 / 部署 / 远程连接 / 维护记录 / 文件 / 审计），方便调试显示样式。生产不要开启。
# SEED_DEMO=1
