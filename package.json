{
  "name": "wsop",
  "private": true,
  "version": "1.2.0",
  "description": "wsop — 私有化维护客户记录系统 (monorepo)",
  "scripts": {
    "dev": "pnpm --filter wsop-desktop tauri dev",
    "desktop:dev": "pnpm --filter wsop-desktop dev",
    "desktop:build": "pnpm --filter wsop-desktop build",
    "tauri:dev": "pnpm --filter wsop-desktop tauri dev",
    "tauri:build": "pnpm --filter wsop-desktop tauri build",
    "server:dev": "cargo run --manifest-path apps/server/Cargo.toml",
    "server:build": "cargo build --release --manifest-path apps/server/Cargo.toml",
    "shared:gen": "cargo test --manifest-path apps/server/Cargo.toml export_bindings"
  }
}
